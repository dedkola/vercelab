NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000

# install.sh will auto-derive the base domain on first run if you do not set it:
#   - Linux:    sslip.io derived from the machine IP, for example 10-0-0-5.sslip.io
#   - macOS:    localhost (see the proxy port notes below)
VERCELAB_BASE_DOMAIN=10-0-0-5.sslip.io
VERCELAB_ADMIN_HOST=vercelab.10-0-0-5.sslip.io
VERCELAB_HOST_LAN_IP=10.0.0.5

VERCELAB_PROXY_NETWORK=vercelab_proxy
VERCELAB_PROXY_ENTRYPOINT=websecure

# Address Traefik publishes on and the host ports it maps to port 80/443.
# macOS installer defaults (localhost-only):
#   VERCELAB_PROXY_BIND_ADDRESS=127.0.0.1
#   VERCELAB_HTTP_PORT=80
#   VERCELAB_HTTPS_PORT=443
#   VERCELAB_PUBLIC_HTTPS_PORT=
# macOS installer defaults with --lan (reachable from other devices on the LAN):
#   VERCELAB_PROXY_BIND_ADDRESS=0.0.0.0
#   VERCELAB_HTTP_PORT=8080
#   VERCELAB_HTTPS_PORT=8443
#   VERCELAB_PUBLIC_HTTPS_PORT=8443
# Ports below 1024 are not reachable from other machines under Docker Desktop for
# macOS, which is why --lan uses high ports.
VERCELAB_PROXY_BIND_ADDRESS=127.0.0.1
VERCELAB_HTTP_PORT=80
VERCELAB_HTTPS_PORT=443
VERCELAB_PUBLIC_HTTPS_PORT=
# Baked into the Next.js build so generated app URLs include the public HTTPS port.
NEXT_PUBLIC_VERCELAB_PUBLIC_HTTPS_PORT=

# install.sh writes the paths below for you. Production defaults live under
# VERCELAB_HOST_ROOT: /home/<user>/vercelab on Ubuntu, ~/vercelab on macOS.
VERCELAB_HOST_ROOT=/opt/vercelab
VERCELAB_DATA_ROOT=/opt/vercelab/data
VERCELAB_TRAEFIK_DYNAMIC_DIR=/opt/vercelab/traefik/dynamic
VERCELAB_TRAEFIK_CERTS_DIR=/opt/vercelab/traefik/certs
VERCELAB_APPS_DIR=/opt/vercelab/data/apps
VERCELAB_LOGS_DIR=/opt/vercelab/data/logs
VERCELAB_LOCKS_DIR=/opt/vercelab/data/locks
VERCELAB_POSTGRES_DATA_DIR=/opt/vercelab/data/postgres
VERCELAB_INFLUXDB_DATA_DIR=/opt/vercelab/data/influxdb
VERCELAB_INFLUXDB_EXPLORER_DATA_DIR=/opt/vercelab/data/influxdb-explorer
VERCELAB_INFLUXDB_EXPLORER_CONFIG_DIR=/opt/vercelab/data/influxdb-explorer-config
VERCELAB_DOCKER_SOCKET_PATH=/var/run/docker.sock

VERCELAB_DATABASE_PROVIDER=postgres
VERCELAB_POSTGRES_URL=postgres://vercelab:replace-me-postgres-password@vercelab-postgres:5432/vercelab
VERCELAB_POSTGRES_USER=vercelab
VERCELAB_POSTGRES_PASSWORD=replace-me-postgres-password
VERCELAB_POSTGRES_DB=vercelab

VERCELAB_INFLUXDB_URL=http://influxdb:8181
VERCELAB_INFLUXDB_DATABASE=vercelab_metrics
VERCELAB_INFLUXDB_EXPLORER_HOST=influx.10-0-0-5.sslip.io
VERCELAB_INFLUXDB_EXPLORER_URL=https://influx.10-0-0-5.sslip.io
VERCELAB_INFLUXDB_EXPLORER_SESSION_SECRET=replace-me-with-a-random-session-secret
# Leave empty on first install to let install.sh auto-generate and persist a token.
VERCELAB_INFLUXDB_TOKEN=
VERCELAB_INFLUXDB_RETENTION_DAYS=90

VERCELAB_ENCRYPTION_SECRET=replace-me-with-a-random-secret

# In production, terminal commands run on the Ubuntu Docker host via a short-lived
# privileged helper container. Use "container" only for debugging the control plane.
# install-macos.sh sets "container" because Docker Desktop does not share the host
# PID namespace; for the same reason it sets VERCELAB_HOST_PROC_PATH=/proc so host
# metrics read container /proc instead of a bind mount.
VERCELAB_TERMINAL_TARGET=host
VERCELAB_HOST_TERMINAL_IMAGE=
VERCELAB_TERMINAL_WS_PORT=3001

# Optional: pre-configure a GitHub personal access token (read:packages + repo scope)
# so it persists across page reloads on the Git deployment page.
VERCELAB_GITHUB_TOKEN=

# Optional: Dev page preview deployment worker tuning.
# VERCELAB_DEV_POLL_INTERVAL_MS=60000
# VERCELAB_DEV_BUILD_TIMEOUT_MS=1800000
